{
  "name": "ctu-chatbot-plugin",
  "version": "1.0.8",
  "private": false,
  "description": "The IT-portal chatbot as a text-only DeepSeek Harness LLM provider.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ctu",
    "llm-provider",
    "chatbot"
  ],
  "author": "ykshek <hms.starryfish@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ykshek/ctu-chatbot-plugin.git"
  },
  "homepage": "https://github.com/ykshek/ctu-chatbot-plugin#readme",
  "bugs": "https://github.com/ykshek/ctu-chatbot-plugin/issues",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "dsh": "^0.2.2-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
